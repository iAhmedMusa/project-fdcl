# ==============================================================================
# FDCL Staging — Coolify Environment Variables Reference
# ==============================================================================
# Add these in Coolify: Project → Resource → Environment Variables
# Mark sensitive values as "Locked" (eye icon) so they're encrypted at rest.
#
# Compose file to use: docker-compose.staging.yml
# Health Check URL:    /up   (port 80)
# ==============================================================================

# ── Required — MUST be set before deploying ──────────────────────────────────

APP_KEY=                           # php artisan key:generate --show
APP_URL=https://staging.focuslab.com.bd

DB_PASSWORD=                       # strong password
DB_ROOT_PASSWORD=                  # strong root password (used by health check)

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────

MAIL_HOST=smtp.example.com         # e.g. smtp.gmail.com, smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@focuslab.com.bd

# ── Google OAuth ──────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.focuslab.com.bd/auth/google/callback

# ── Defaults (already set in docker-compose.staging.yml) ─────────────────────
# Override here only if you need different values.
#
# APP_NAME=Focus Digital Color Lab
# APP_ENV=staging
# APP_DEBUG=false
# APP_TIMEZONE=Asia/Dhaka
# LOG_LEVEL=warning
# DB_HOST=db                       # change to external host if not using compose db service
# DB_PORT=3306
# DB_DATABASE=focus_lab
# DB_USERNAME=focuslab
# SESSION_LIFETIME=120
# MAIL_FROM_NAME=Focus Digital Color Lab
