# Copy this file to .env.docker and fill in your values.

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_DATABASE=focus_lab
MYSQL_USER=focuslab
MYSQL_PASSWORD=your_db_password
MYSQL_ROOT_PASSWORD=your_root_password

# ── Laravel DB connection ─────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_DATABASE=focus_lab
DB_USERNAME=focuslab
DB_PASSWORD=your_db_password

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000

# ── Mail (Mailpit) ────────────────────────────────────────────────────────────
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@focusdigitalcolorlab.com
MAIL_FROM_NAME="Focus Digital Color Lab"
