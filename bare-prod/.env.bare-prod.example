# ==============================================================================
# FDCL — Bare Production (VPS) environment variables
# ==============================================================================
# Copy this to `.env.bare-prod` (production) or `.env.bare-prod.local` (local
# mkcert test) and fill in real values. Both files are gitignored.
#
#   cp .env.bare-prod.example .env.bare-prod
#   cp .env.bare-prod.example .env.bare-prod.local
# ==============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Focus Digital Color Lab"
APP_ENV=production
APP_KEY=                                      # run: docker compose -f docker-compose.bare-prod.yml run --rm app php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://focusdigitalcolorlab.com
APP_DOMAIN=focusdigitalcolorlab.com           # Traefik Host() rule. For local set to: ahmedmusa.local
APP_TIMEZONE=Asia/Dhaka

# ── Traefik / Let's Encrypt (production only) ─────────────────────────────────
ACME_EMAIL=admin@focusdigitalcolorlab.com     # Let's Encrypt account email

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=focus_lab
DB_USERNAME=focuslab
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# ── Session / Cache / Queue ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@focusdigitalcolorlab.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://focusdigitalcolorlab.com/auth/google/callback
