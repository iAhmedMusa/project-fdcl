# ==============================================================================
# FDCL Production — Coolify Environment Variables Reference
# ==============================================================================
# This file is a REFERENCE for setting environment variables in Coolify's UI.
# Do NOT copy this as .env.prod — Coolify injects variables via its dashboard.
#
# In Coolify: Project → Resource → Environment → add each variable below.
# Mark secrets as "Locked" (eye icon) so they're encrypted at rest.
# ==============================================================================

# ── Required Variables ───────────────────────────────────────────────────────
# These MUST be set in Coolify before deploying.

APP_KEY=                                        # Generate: php artisan key:generate
APP_URL=https://focuslab.com.bd                  # Your production domain
DB_DATABASE=focus_lab                            # Database name
DB_USERNAME=focuslab                             # Database user
DB_PASSWORD=                                     # Strong DB password
MYSQL_ROOT_PASSWORD=                             # Strong MySQL root password

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_HOST=                                       # e.g. smtp.gmail.com, smtp.mailtrap.io
MAIL_PORT=587                                    # Usually 587 for TLS
MAIL_USERNAME=                                   # SMTP username
MAIL_PASSWORD=                                   # SMTP password
MAIL_FROM_ADDRESS=noreply@focuslab.com.bd        # Sender email

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                                # From Google Cloud Console
GOOGLE_CLIENT_SECRET=                            # From Google Cloud Console
GOOGLE_REDIRECT_URI=https://focuslab.com.bd/auth/google/callback

# ── Pre-configured Defaults (already set in docker-compose.prod.yml) ──────────
# These are set as defaults in docker-compose.prod.yml. Override in Coolify
# only if you need different values.
#
# APP_NAME="Focus Digital Color Lab"
# APP_ENV=production
# APP_DEBUG=false
# APP_TIMEZONE=Asia/Dhaka
# LOG_CHANNEL=daily
# LOG_LEVEL=warning
# DB_CONNECTION=mysql
# DB_HOST=db
# DB_PORT=3306
# SESSION_DRIVER=database
# SESSION_LIFETIME=120
# CACHE_STORE=database
# QUEUE_CONNECTION=database
# MAIL_MAILER=smtp
# MAIL_ENCRYPTION=tls