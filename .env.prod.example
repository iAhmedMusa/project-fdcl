# ==============================================================================
# FDCL Production Environment Template
# Copy this file to .env.prod and fill in the values.
# ==============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Focus Digital Color Lab"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://focuslab.com.bd

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=focus_lab
DB_USERNAME=focuslab
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

# MySQL container variables
MYSQL_DATABASE=focus_lab
MYSQL_USER=focuslab
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# ── Session / Cache / Queue ─────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=focuslab.com.bd

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Mail (SMTP) ──────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_MAIL_USERNAME
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@focuslab.com.bd
MAIL_FROM_NAME="Focus Digital Color Lab"

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://focuslab.com.bd/auth/google/callback

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"