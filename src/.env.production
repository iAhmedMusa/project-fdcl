APP_NAME="Focus Digital Color Lab"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://focuslab.com.bd           # Override in Coolify with your domain

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr                         # stdout/stderr for Coolify log viewer
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db                                 # Override in Coolify if using external DB
DB_PORT=3306
DB_DATABASE=focus_lab
DB_USERNAME=focuslab
DB_PASSWORD=secret                         # MUST override in Coolify

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com                 # Override in Coolify with your SMTP host
MAIL_PORT=587
MAIL_USERNAME=null                         # Override in Coolify
MAIL_PASSWORD=null                         # Override in Coolify
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@focuslab.com.bd"
MAIL_FROM_NAME="Focus Digital Color Lab"

GOOGLE_CLIENT_ID=                          # Override in Coolify
GOOGLE_CLIENT_SECRET=                      # Override in Coolify
GOOGLE_REDIRECT_URI=https://focuslab.com.bd/auth/google/callback

VITE_APP_NAME="Focus Digital Color Lab"